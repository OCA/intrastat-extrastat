<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="custom_account_fiscal_position_view_form">
        <field name="name">account.fiscal.position.form</field>
        <field name="model">account.fiscal.position</field>
        <field name="inherit_id" ref="account.view_account_position_form" />
        <field name="arch" type="xml">
            <page name="account_mapping" position="after">
                <page string="Configuration" name="configuration">
                    <group>
                        <group string="Invoice" name="invoice">
                            <field name="display_hscode" />
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
